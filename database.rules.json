{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && $room.matches(/^[0-9]{6}$/)",
        "players": {
          "$pid": {
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 8"
          }
        }
      }
    }
  }
}
